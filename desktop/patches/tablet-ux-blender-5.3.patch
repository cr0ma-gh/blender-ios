+static wmEventModifierFlag g_sticky_modifier_oneshot = wmEventModifierFlag(0);
+static wmEventModifierFlag g_sticky_modifier_locked = wmEventModifierFlag(0);
+/** Set when the sticky state changes while handling an event, so that event doesn't consume it. */
+static bool g_sticky_modifier_changed = false;
+/** A mouse button press started over the status bar while a modal operator was running. */
+static bool g_status_bar_press_active = false;
+
+wmEventModifierFlag WM_sticky_modifiers_get()
+{
+  return g_sticky_modifier_oneshot | g_sticky_modifier_locked;
+}
+
+wmEventModifierFlag WM_sticky_modifiers_locked_get()
+{
+  return g_sticky_modifier_locked;
+}
+
+void WM_sticky_modifier_toggle(const wmEventModifierFlag modifier, const bool lock)
+{
+  const bool is_locked = (g_sticky_modifier_locked & modifier) != 0;
+  const bool is_oneshot = (g_sticky_modifier_oneshot & modifier) != 0;
+  g_sticky_modifier_oneshot &= ~modifier;
+  g_sticky_modifier_locked &= ~modifier;
+  if (lock) {
+    if (!is_locked) {
+      g_sticky_modifier_locked |= modifier;
+    }
+  }
+  else if (is_oneshot) {
+    g_sticky_modifier_locked |= modifier;
+  }
+  else if (!is_locked) {
+    g_sticky_modifier_oneshot |= modifier;
+  }
+  g_sticky_modifier_changed = true;
+  WM_main_add_notifier(NC_WINDOW, nullptr);
+}
+
+void WM_sticky_modifiers_clear()
+{
+  g_sticky_modifier_oneshot = wmEventModifierFlag(0);
+  g_sticky_modifier_locked = wmEventModifierFlag(0);
+  g_sticky_modifier_changed = true;
+  WM_main_add_notifier(NC_WINDOW, nullptr);
+}
+
+/** Add the sticky modifiers to an event about to be handled. */
+static void wm_event_sticky_modifiers_apply(wmEvent *event)
+{
+  const wmEventModifierFlag sticky = WM_sticky_modifiers_get();
+  if (sticky == 0) {
+    return;
+  }
+  event->modifier |= sticky;
+  /* Click-drag events take the modifiers of the press. */
+  event->prev_press_modifier |= sticky;
+}
+
+/** After an event was handled: a completed click or a key press consumes one-shot modifiers. */
+static void wm_event_sticky_modifiers_consume(const wmEvent *event)
+{
+  if (g_sticky_modifier_changed) {
+    /* Changed by this very event (e.g. clicking a modifier toggle): keep it for the next one. */
+    g_sticky_modifier_changed = false;
+    return;
+  }
+  if (g_sticky_modifier_oneshot == 0) {
+    return;
+  }
+  const bool is_button_release = ISMOUSE_BUTTON(event->type) && (event->val == KM_RELEASE);
+  const bool is_key_press = ISKEYBOARD(event->type) && !ISKEYMODIFIER(event->type) &&
+                            (event->val == KM_PRESS);
+  if (is_button_release || is_key_press) {
+    g_sticky_modifier_oneshot = wmEventModifierFlag(0);
+    WM_main_add_notifier(NC_WINDOW, nullptr);
+  }
