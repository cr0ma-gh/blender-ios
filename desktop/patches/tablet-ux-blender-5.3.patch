+static bool wm_event_status_bar_bypass_modal(wmWindow *win, const wmEvent *event)
+{
+  const bool is_button = ISMOUSE_BUTTON(event->type);
+  if (!is_button && !ISMOUSE_MOTION(event->type)) {
