+/** True when \a xy is over the status bar of \a win while a modal operator runs. */
+static bool wm_status_bar_modal_hit(wmWindow *win, const int xy[2])
+{
+  if (!WM_window_modal_operator_running(win)) {
+    return false;
+  }
+  bScreen *screen = WM_window_get_active_screen(win);
+  ScrArea *status_area = screen ? WM_window_status_area_find(win, screen) : nullptr;
