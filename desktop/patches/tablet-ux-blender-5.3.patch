+/* -------------------------------------------------------------------- */
+/** \name Tablet Input Operators
+ *
+ * Sticky (on-screen) modifiers and key presses from the status bar, for touch & pen input.
+ * \{ */
+
+static wmOperatorStatus wm_sticky_modifier_toggle_exec(bContext * /*C*/, wmOperator *op)
+{
+  const wmEventModifierFlag modifier = wmEventModifierFlag(RNA_enum_get(op->ptr, "modifier"));
+  WM_sticky_modifier_toggle(modifier, RNA_boolean_get(op->ptr, "lock"));
+  return OPERATOR_FINISHED;
+}
+
+static void WM_OT_sticky_modifier_toggle(wmOperatorType *ot)
+{
+  ot->name = "Toggle Sticky Modifier";
+  ot->idname = "WM_OT_sticky_modifier_toggle";
+  ot->description =
+      "Hold a modifier key from the screen: for the next click, then locked, then off "
+      "(for touch and pen input)";
+
+  ot->exec = wm_sticky_modifier_toggle_exec;
+
+  PropertyRNA *prop;
+  prop = RNA_def_enum(
+      ot->srna, "modifier", rna_enum_sticky_modifier_items, KM_SHIFT, "Modifier", "");
+  RNA_def_property_flag(prop, PROP_SKIP_SAVE);
+  prop = RNA_def_boolean(ot->srna,
+                         "lock",
+                         false,
+                         "Lock",
+                         "Toggle between locked and off instead of cycling through one-shot");
+  RNA_def_property_flag(prop, PROP_SKIP_SAVE);
+}
+
+static wmOperatorStatus wm_sticky_modifier_clear_exec(bContext * /*C*/, wmOperator * /*op*/)
+{
+  WM_sticky_modifiers_clear();
+  return OPERATOR_FINISHED;
+}
+
+static void WM_OT_sticky_modifier_clear(wmOperatorType *ot)
+{
+  ot->name = "Release Sticky Modifiers";
+  ot->idname = "WM_OT_sticky_modifier_clear";
+  ot->description = "Release all modifier keys held from the screen";
+
+  ot->exec = wm_sticky_modifier_clear_exec;
+}
+
+static wmOperatorStatus wm_status_key_press_exec(bContext *C, wmOperator *op)
+{
+  wmWindow *win = CTX_wm_window(C);
+  if (win == nullptr) {
+    return OPERATOR_CANCELLED;
+  }
+  const wmEventType type = wmEventType(RNA_int_get(op->ptr, "type"));
+  if (!(ISKEYBOARD(type) || ISMOUSE_BUTTON(type))) {
+    return OPERATOR_CANCELLED;
+  }
+  const wmEventModifierFlag modifier = wmEventModifierFlag(RNA_int_get(op->ptr, "modifier"));
+  WM_event_add_key_press(win, type, modifier);
+  return OPERATOR_FINISHED;
+}
+
+static void WM_OT_status_key_press(wmOperatorType *ot)
+{
+  ot->name = "Press Key";
+  ot->idname = "WM_OT_status_key_press";
+  ot->description = "Press this key for the running tool (for touch and pen input)";
+
+  ot->exec = wm_status_key_press_exec;
+  ot->flag = OPTYPE_INTERNAL;
+
+  PropertyRNA *prop;
+  prop = RNA_def_int(ot->srna, "type", 0, 0, INT16_MAX, "Type", "Event type", 0, INT16_MAX);
+  RNA_def_property_flag(prop, PROP_HIDDEN | PROP_SKIP_SAVE);
+  prop = RNA_def_int(ot->srna, "modifier", 0, 0, 255, "Modifier", "Modifier flags", 0, 255);
+  RNA_def_property_flag(prop, PROP_HIDDEN | PROP_SKIP_SAVE);
+}
+
