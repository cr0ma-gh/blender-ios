+# SPDX-FileCopyrightText: 2026 Blender Authors
+#
+# SPDX-License-Identifier: GPL-2.0-or-later
+
+"""
+Tablet UX: touch / pen friendly controls for using Blender without mouse and keyboard.
+
+Implements items of the "Blender on Tablet: Path to Release" plan (code.blender.org, 2026-11)
+on top of the existing desktop UI:
+
+- Beyond Mouse and Keyboard (#165853):
+  - Top level search (#165902): a search button in the top bar that searches menus of the
+    main 3D Viewport (or the largest editor), wherever it is pressed.
+  - Modifier wheel (#165901): a pie menu and a status bar dock with Ctrl / Shift / Alt / OS
+    "sticky" modifiers (one-shot or locked), implemented in the window-manager
+    (``wm.sticky_modifier_toggle``).
+  - On-screen keyboard (#165899): button to open the operating system's touch keyboard.
+  - Clickable status bar (#165900): implemented in C++ (modal key hints become buttons).
+- Compact UI use cases:
+  - Portfolio Review (#166024): navigation pie, shading & overlay popover, toggle UI (focus),
+    open file, search.
+  - Scene Assembly (#166529): save, "Add" menu, context menu, undo / redo buttons.
+  - Sculpting (#166714): central tool options block (radius, strength, remesh, dyntopo).
+- Responsive UI: a one-click "touch size" UI scale toggle for larger touch targets.
+"""
+
+bl_info = {
+    "name": "Tablet UX",
+    "description": "Touch and pen friendly controls (modifier wheel, search, pies, touch sizes)",
+    "author": "Blender Foundation",
+    "version": (1, 0),
+    "blender": (5, 3, 0),
+    "location": "3D Viewport header, Top bar, Status bar",
+    "support": "OFFICIAL",
+    "category": "Interface",
+}
+
+import os
+import sys
+
+import bpy
+from bpy.props import BoolProperty, EnumProperty, FloatProperty
+from bpy.types import AddonPreferences, Menu, Operator, Panel
+
+
+# -----------------------------------------------------------------------------
+# Helpers
+
+
+def _prefs(context):
+    addon = context.preferences.addons.get(__package__)
+    return addon.preferences if addon else None
+
+
+def _has_sticky_modifiers():
+    # RNA properties aren't Python class attributes: check the RNA definition.
+    return "sticky_modifiers" in bpy.types.WindowManager.bl_rna.properties
+
+
+def _largest_area(screen, area_type=None):
+    best = None
+    for area in screen.areas:
+        if area_type and area.type != area_type:
+            continue
+        if best is None or (area.width * area.height) > (best.width * best.height):
+            best = area
+    return best
+
+
+def _main_region(area):
+    for region in area.regions:
+        if region.type == 'WINDOW':
+            return region
+    return None
+
+
+# Mode -> (kind, name) of the context menu normally opened with right-click.
+_CONTEXT_MENUS = {
+    'OBJECT': ('MENU', "VIEW3D_MT_object_context_menu"),
+    'EDIT_MESH': ('MENU', "VIEW3D_MT_edit_mesh_context_menu"),
+    'EDIT_CURVE': ('MENU', "VIEW3D_MT_edit_curve_context_menu"),
+    'EDIT_CURVES': ('MENU', "VIEW3D_MT_edit_curves_context_menu"),
+    'EDIT_SURFACE': ('MENU', "VIEW3D_MT_edit_curve_context_menu"),
+    'EDIT_TEXT': ('MENU', "VIEW3D_MT_edit_font_context_menu"),
+    'EDIT_ARMATURE': ('MENU', "VIEW3D_MT_armature_context_menu"),
+    'EDIT_METABALL': ('MENU', "VIEW3D_MT_edit_metaball_context_menu"),
+    'EDIT_LATTICE': ('MENU', "VIEW3D_MT_edit_lattice_context_menu"),
+    'EDIT_GREASE_PENCIL': ('MENU', "VIEW3D_MT_greasepencil_edit_context_menu"),
+    'POSE': ('MENU', "VIEW3D_MT_pose_context_menu"),
+    'PARTICLE': ('MENU', "VIEW3D_MT_particle_context_menu"),
+    'SCULPT': ('PANEL', "VIEW3D_PT_sculpt_context_menu"),
+    'PAINT_VERTEX': ('PANEL', "VIEW3D_PT_paint_vertex_context_menu"),
+    'PAINT_TEXTURE': ('PANEL', "VIEW3D_PT_paint_texture_context_menu"),
+    'PAINT_WEIGHT': ('PANEL', "VIEW3D_PT_paint_weight_context_menu"),
+    'PAINT_GREASE_PENCIL': ('PANEL', "VIEW3D_PT_greasepencil_draw_context_menu"),
+    'SCULPT_GREASE_PENCIL': ('PANEL', "VIEW3D_PT_greasepencil_sculpt_context_menu"),
+    'VERTEX_GREASE_PENCIL': ('PANEL', "VIEW3D_PT_greasepencil_vertex_paint_context_menu"),
+    'WEIGHT_GREASE_PENCIL': ('PANEL', "VIEW3D_PT_greasepencil_weight_context_menu"),
+}
+
+# Mode -> "Add" menu.
+_ADD_MENUS = {
+    'OBJECT': "VIEW3D_MT_add",
+    'EDIT_MESH': "VIEW3D_MT_mesh_add",
+    'EDIT_CURVE': "VIEW3D_MT_curve_add",
+}
+
+
+# -----------------------------------------------------------------------------
+# Operators
+
+
+class TABLET_OT_search(Operator):
+    """Search menus and operators of the main editor, from anywhere (top level search)"""
+    bl_idname = "tablet.search"
+    bl_label = "Search"
+    bl_options = {'INTERNAL'}
+
+    def invoke(self, context, _event):
+        area = context.area
+        if area is None or area.type in {'TOPBAR', 'STATUSBAR'}:
+            area = _largest_area(context.screen, 'VIEW_3D') or _largest_area(context.screen)
+        if area is None:
+            return {'CANCELLED'}
+        region = _main_region(area)
+        with context.temp_override(area=area, region=region):
+            bpy.ops.wm.search_menu('INVOKE_DEFAULT')
+        return {'FINISHED'}
+
+
+class TABLET_OT_context_menu(Operator):
+    """Open the context menu of the current mode (same as right-click)"""
+    bl_idname = "tablet.context_menu"
+    bl_label = "Context Menu"
+    bl_options = {'INTERNAL'}
+
+    @classmethod
+    def poll(cls, context):
+        return context.mode in _CONTEXT_MENUS
+
+    def invoke(self, context, _event):
+        kind, name = _CONTEXT_MENUS[context.mode]
+        area = context.area if (context.area and context.area.type == 'VIEW_3D') else \
+            _largest_area(context.screen, 'VIEW_3D')
+        if area is None:
+            return {'CANCELLED'}
+        with context.temp_override(area=area, region=_main_region(area)):
+            if kind == 'MENU':
+                bpy.ops.wm.call_menu(name=name)
+            else:
+                bpy.ops.wm.call_panel(name=name, keep_open=False)
+        return {'FINISHED'}
+
+
+class TABLET_OT_touch_keyboard(Operator):
+    """Show the operating system's on-screen (touch) keyboard"""
+    bl_idname = "tablet.touch_keyboard"
+    bl_label = "On-Screen Keyboard"
+    bl_options = {'INTERNAL'}
+
+    @classmethod
+    def poll(cls, _context):
+        return sys.platform == "win32"
+
+    def execute(self, _context):
+        candidates = [
+            os.path.join(os.environ.get("CommonProgramFiles", r"C:\Program Files\Common Files"),
+                         "microsoft shared", "ink", "TabTip.exe"),
+            os.path.join(os.environ.get("SystemRoot", r"C:\Windows"), "System32", "osk.exe"),
+        ]
+        for exe in candidates:
+            if os.path.isfile(exe):
+                try:
+                    os.startfile(exe)
+                    return {'FINISHED'}
+                except OSError:
+                    continue
+        self.report({'WARNING'}, "No on-screen keyboard found")
+        return {'CANCELLED'}
+
+
+class TABLET_OT_touch_scale_toggle(Operator):
+    """Toggle larger interface elements for touch input"""
+    bl_idname = "tablet.touch_scale_toggle"
+    bl_label = "Touch Size Interface"
+    bl_options = {'INTERNAL'}
+
+    def execute(self, context):
+        prefs = _prefs(context)
+        view = context.preferences.view
+        touch_scale = prefs.touch_ui_scale if prefs else 1.3
+        view.ui_scale = 1.0 if abs(view.ui_scale - touch_scale) < 1e-3 else touch_scale
+        return {'FINISHED'}
+
+
+# -----------------------------------------------------------------------------
+# Modifier Wheel
+
+
+def _draw_modifier_toggle(layout, wm, modifier, text, icon, lock=False):
+    active = modifier in wm.sticky_modifiers
+    locked = modifier in wm.sticky_modifiers_locked
+    props = layout.operator(
+        "wm.sticky_modifier_toggle",
+        text=text,
+        icon='LOCKED' if (lock or locked) else icon,
+        depress=(locked if lock else active),
+    )
+    props.modifier = modifier
+    props.lock = lock
+
+
+class WM_MT_tablet_modifier_wheel(Menu):
+    """Floating radial menu for Ctrl / Shift / Alt / OS modifiers"""
+    bl_label = "Modifier Wheel"
+
+    def draw(self, context):
+        pie = self.layout.menu_pie()
+        wm = context.window_manager
+        if not _has_sticky_modifiers():
+            pie.label(text="Sticky modifiers unavailable in this build")
+            return
+        os_name = "Cmd" if sys.platform == "darwin" else "Win" if sys.platform == "win32" else "OS"
+        # Order: West, East, South, North, North-West, North-East, South-West, South-East.
+        _draw_modifier_toggle(pie, wm, 'CTRL', "Ctrl", 'EVENT_CTRL')
+        _draw_modifier_toggle(pie, wm, 'ALT', "Alt", 'EVENT_ALT')
+        _draw_modifier_toggle(pie, wm, 'SHIFT', "Shift", 'EVENT_SHIFT')
+        _draw_modifier_toggle(pie, wm, 'OSKEY', os_name, 'EVENT_OS')
+        _draw_modifier_toggle(pie, wm, 'CTRL', "Lock Ctrl", 'EVENT_CTRL', lock=True)
+        _draw_modifier_toggle(pie, wm, 'ALT', "Lock Alt", 'EVENT_ALT', lock=True)
+        _draw_modifier_toggle(pie, wm, 'SHIFT', "Lock Shift", 'EVENT_SHIFT', lock=True)
+        pie.operator("wm.sticky_modifier_clear", text="Release All", icon='X')
+
+
+def draw_statusbar_modifiers(self, context):
+    """Docked modifier wheel at the start of the status bar."""
+    prefs = _prefs(context)
+    if not (prefs and prefs.show_statusbar_modifiers and _has_sticky_modifiers()):
+        return
+    wm = context.window_manager
+    row = self.layout.row(align=True)
+    _draw_modifier_toggle(row, wm, 'CTRL', "", 'EVENT_CTRL')
+    _draw_modifier_toggle(row, wm, 'SHIFT', "", 'EVENT_SHIFT')
+    _draw_modifier_toggle(row, wm, 'ALT', "", 'EVENT_ALT')
+    _draw_modifier_toggle(row, wm, 'OSKEY', "", 'EVENT_OS')
+    self.layout.separator(type='LINE')
+
+
+# -----------------------------------------------------------------------------
+# Popovers
+
+
+class VIEW3D_PT_tablet_display(Panel):
+    """Shading and overlays in one touch-sized popover"""
+    bl_space_type = 'VIEW_3D'
+    bl_region_type = 'HEADER'
+    bl_label = "Display"
+    bl_ui_units_x = 11
+
+    def draw(self, context):
+        layout = self.layout
+        view = context.space_data
+        shading = view.shading
+        overlay = view.overlay
+
+        layout.label(text="Shading")
+        layout.row(align=True).prop(shading, "type", expand=True)
+        if shading.type in {'SOLID', 'WIREFRAME'}:
+            layout.prop(shading, "show_xray", text="X-Ray")
+
+        layout.separator()
+        layout.label(text="Overlays")
+        layout.prop(overlay, "show_overlays", text="Show Overlays")
+        col = layout.column()
+        col.active = overlay.show_overlays
+        col.prop(overlay, "show_floor", text="Floor")
+        col.prop(overlay, "show_wireframes", text="Wireframe")
+        col.prop(overlay, "show_face_orientation", text="Face Orientation")
+        col.prop(overlay, "show_stats", text="Statistics")
+        layout.prop(view, "show_gizmo", text="Gizmos")
+
+
+class VIEW3D_PT_tablet_sculpt(Panel):
+    """Central sculpt tool options: radius, strength, remesh and dynamic topology"""
+    bl_space_type = 'VIEW_3D'
+    bl_region_type = 'HEADER'
+    bl_label = "Sculpt"
+    bl_ui_units_x = 12
+
+    @classmethod
+    def poll(cls, context):
+        return context.mode == 'SCULPT' and context.sculpt_object is not None
+
+    def draw(self, context):
+        from bl_ui.properties_paint_common import UnifiedPaintPanel
+
+        layout = self.layout
+        obj = context.sculpt_object
+        brush = context.tool_settings.sculpt.brush
+
+        if brush is not None:
+            col = layout.column()
+            UnifiedPaintPanel.prop_unified(
+                col, context, brush, "size",
+                unified_name="use_unified_size", pressure_name="use_pressure_size",
+                text="Radius", slider=True,
+            )
+            UnifiedPaintPanel.prop_unified(
+                col, context, brush, "strength",
+                unified_name="use_unified_strength", pressure_name="use_pressure_strength",
+                text="Strength", slider=True,
+            )
+
+        layout.separator()
+        layout.label(text="Remesh")
+        row = layout.row(align=True)
+        row.prop(obj.data, "remesh_voxel_size", text="Voxel Size")
+        row.operator("object.voxel_remesh", text="Remesh")
+
+        layout.separator()
+        layout.operator(
+            "sculpt.dynamic_topology_toggle",
+            text="Dynamic Topology",
+            depress=obj.use_dynamic_topology_sculpting,
+        )
+        if obj.use_dynamic_topology_sculpting:
+            layout.prop(context.tool_settings.sculpt, "detail_size")
+
+
+# -----------------------------------------------------------------------------
+# Header / top bar drawing
+
+
+def draw_view3d_header(self, context):
+    prefs = _prefs(context)
+    if not (prefs and prefs.show_header_buttons):
+        return
+    layout = self.layout
+    mode = context.mode
+
+    layout.separator(type='LINE')
+    row = layout.row(align=True)
+    add_menu = _ADD_MENUS.get(mode)
+    if add_menu:
+        row.menu(add_menu, text="", icon='ADD')
+    if mode in _CONTEXT_MENUS:
+        row.operator("tablet.context_menu", text="", icon='COLLAPSEMENU')
+
+    row = layout.row(align=True)
+    row.operator("wm.call_menu_pie", text="", icon='VIEW3D').name = "VIEW3D_MT_view_pie"
+    row.popover(panel="VIEW3D_PT_tablet_display", text="", icon='SHADING_RENDERED')
+    if mode == 'SCULPT':
+        row.popover(panel="VIEW3D_PT_tablet_sculpt", text="", icon='SCULPTMODE_HLT')
+    row.operator("screen.screen_full_area", text="", icon='FULLSCREEN_ENTER').use_hide_panels = True
+
+    if _has_sticky_modifiers():
+        layout.operator("wm.call_menu_pie", text="", icon='EVENT_SHIFT').name = \
+            "WM_MT_tablet_modifier_wheel"
+
+
+def draw_topbar(self, context):
+    prefs = _prefs(context)
+    if not (prefs and prefs.show_topbar_buttons):
+        return
+    if context.region.alignment != 'RIGHT':
+        return
+    layout = self.layout
+
+    row = layout.row(align=True)
+    row.operator("tablet.search", text="", icon='VIEWZOOM')
+
+    row = layout.row(align=True)
+    row.operator("ed.undo", text="", icon='LOOP_BACK')
+    row.operator("ed.redo", text="", icon='LOOP_FORWARDS')
+
+    row = layout.row(align=True)
+    row.operator("wm.open_mainfile", text="", icon='FILE_FOLDER')
+    row.operator("wm.save_mainfile", text="", icon='FILE_TICK')
+
+    row = layout.row(align=True)
+    if sys.platform == "win32":
+        row.operator("tablet.touch_keyboard", text="", icon='KEYINGSET')
+    row.operator(
+        "tablet.touch_scale_toggle", text="", icon='FULLSCREEN_ENTER',
+        depress=abs(context.preferences.view.ui_scale - (prefs.touch_ui_scale)) < 1e-3,
+    )
+
+
+# -----------------------------------------------------------------------------
+# Preferences
+
+
+class TabletUXPreferences(AddonPreferences):
+    bl_idname = __package__
+
+    show_header_buttons: BoolProperty(
+        name="3D Viewport Header Buttons",
+        description="Show search, add, context menu, view pie, display, sculpt and focus buttons",
+        default=True,
+    )
+    show_topbar_buttons: BoolProperty(
+        name="Top Bar Buttons",
+        description="Show search, undo/redo, open/save, keyboard and touch size buttons",
+        default=True,
+    )
+    show_statusbar_modifiers: BoolProperty(
+        name="Status Bar Modifier Keys",
+        description="Show the docked modifier wheel (Ctrl, Shift, Alt, OS) in the status bar",
+        default=True,
+    )
+    touch_ui_scale: FloatProperty(
+        name="Touch Interface Scale",
+        description="Interface scale used by the touch size toggle",
+        default=1.3, min=1.0, max=2.0,
+    )
+
+    def draw(self, _context):
+        layout = self.layout
+        layout.use_property_split = True
+        col = layout.column(heading="Show")
+        col.prop(self, "show_header_buttons")
+        col.prop(self, "show_topbar_buttons")
+        col.prop(self, "show_statusbar_modifiers")
+        layout.prop(self, "touch_ui_scale")
+
+
+# -----------------------------------------------------------------------------
+# Registration
+
+classes = (
+    TabletUXPreferences,
+    TABLET_OT_search,
+    TABLET_OT_context_menu,
+    TABLET_OT_touch_keyboard,
+    TABLET_OT_touch_scale_toggle,
+    WM_MT_tablet_modifier_wheel,
+    VIEW3D_PT_tablet_display,
+    VIEW3D_PT_tablet_sculpt,
+)
+
+
+def register():
+    for cls in classes:
+        bpy.utils.register_class(cls)
+    bpy.types.VIEW3D_HT_header.append(draw_view3d_header)
+    bpy.types.TOPBAR_HT_upper_bar.append(draw_topbar)
+    bpy.types.STATUSBAR_HT_header.prepend(draw_statusbar_modifiers)
+
+
+def unregister():
+    bpy.types.STATUSBAR_HT_header.remove(draw_statusbar_modifiers)
+    bpy.types.TOPBAR_HT_upper_bar.remove(draw_topbar)
+    bpy.types.VIEW3D_HT_header.remove(draw_view3d_header)
+    for cls in reversed(classes):
+        bpy.utils.unregister_class(cls)
