+bool WM_window_modal_operator_running(const wmWindow *win)
+{
+  for (const wmEventHandler &handler_base : win->runtime->modalhandlers) {
+    if (handler_base.type == WM_HANDLER_TYPE_OP) {
+      const wmEventHandler_Op *handler = reinterpret_cast<const wmEventHandler_Op *>(
+          &handler_base);
+      if (handler->op != nullptr) {
