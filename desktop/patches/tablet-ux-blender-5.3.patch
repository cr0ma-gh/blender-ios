+/**
+ * When set, key hints drawn by the status bar templates are buttons that press their key
+ * (for touch & pen input while a modal operator runs), instead of plain labels.
+ */
+static bool g_status_bar_hints_clickable = false;
+
+void template_status_bar_hints_clickable_set(const bool clickable)
+{
+  g_status_bar_hints_clickable = clickable;
+}
+
+/** A key hint: label, or a button pressing the key of \a kmi when hints are clickable. */
+static void status_hint_label(Layout *layout,
+                              const StringRef text,
+                              const int icon,
+                              const wmKeyMapItem *kmi)
+{
+  if (g_status_bar_hints_clickable && kmi && (ISKEYBOARD(kmi->type) || ISMOUSE_BUTTON(kmi->type)))
+  {
+    uint8_t modifier = 0;
+    modifier |= (kmi->shift == KM_MOD_HELD) ? KM_SHIFT : 0;
+    modifier |= (kmi->ctrl == KM_MOD_HELD) ? KM_CTRL : 0;
+    modifier |= (kmi->alt == KM_MOD_HELD) ? KM_ALT : 0;
+    modifier |= (kmi->oskey == KM_MOD_HELD) ? KM_OSKEY : 0;
+    PointerRNA ptr = layout->op("WM_OT_status_key_press", text, icon);
+    RNA_int_set(&ptr, "type", kmi->type);
+    RNA_int_set(&ptr, "modifier", modifier);
+    /* Keep the compact look of the labels. */
+    layout->block()->buttons_ptrs.last()->drawflag |= BUT_TEXT_LEFT;
+    return;
+  }
+  layout->label(text, icon);
+}
